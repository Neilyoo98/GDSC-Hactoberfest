OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-astra
TAVILY_API_KEY=

# Chain mode: mock (test data) | anchor (real devnet program)
NEXT_PUBLIC_CHAIN=mock
NEXT_PUBLIC_BURNER=0
NEXT_PUBLIC_GASLESS=1

SOLANA_RPC_URL=https://api.devnet.solana.com
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com
NEXT_PUBLIC_PROGRAM_ID=GYupVpsMEY12UGgS1gUdabq4UvmbR6PvbmUewQbw7gap
# Public devnet values written by `npm run keys` + `npm run setup:devnet`:
NEXT_PUBLIC_TUSDC_MINT=
NEXT_PUBLIC_CONFIG_ADMIN=
NEXT_PUBLIC_FEE_PAYER_PUBKEY=

# Server secrets (JSON byte arrays) from `npm run keys`. Never commit; share by private DM.
FEE_PAYER_SECRET=
RESOLVER_SECRET=

# 3 council public keys, comma-separated (used by setup:devnet)
COUNCIL_PUBKEYS=
# Challenge window in seconds for setup:devnet (30 demo, 86400 production)
CHALLENGE_WINDOW=30

APP_URL=http://localhost:3000
PUBLIC_BASE_URL=
DEMO_WALLETS=

# Public URL for "Share on X" links (deployed site or tunnel). Empty = current address.
NEXT_PUBLIC_SITE_URL=
